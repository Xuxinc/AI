.character-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 角色头部信息 */
.character-header {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.avatar-section {
  position: relative;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.character-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.character-info {
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.character-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.character-description {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 详细信息区域 */
.character-details {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.detail-section {
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.edit-button {
  background: #007aff;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(0, 122, 255, 0.2);
}

.edit-button:active {
  background: #0056cc;
  transform: translateY(1rpx);
}

.upload-voice-button {
  background: #28a745;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(40, 167, 69, 0.2);
  margin-left: 16rpx;
}

.upload-voice-button:active {
  background: #1e7e34;
  transform: translateY(1rpx);
}

/* 录音要求提示 */
.voice-requirements {
  margin: 16rpx 0;
  padding: 12rpx 16rpx;
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
}

.requirements-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.4;
}

.section-content {
  min-height: 60rpx;
  overflow: visible;
  width: 100%;
  box-sizing: border-box;
}

.prompt-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  padding: 16rpx 16rpx 20rpx 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  display: block;
  margin-bottom: 4rpx;
  width: 100%;
  box-sizing: border-box;
}

.prompt-textarea {
  width: 100%;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 16rpx 16rpx 20rpx 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #fafafa;
  resize: none;
  box-sizing: border-box;
}

.voice-model-text {
  font-size: 26rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  line-height: 1.4;
  width: 100%;
  box-sizing: border-box;
}

.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  background: #fafafa;
  min-height: 60rpx;
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  line-height: 1.4;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 创建信息 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 编辑操作按钮 */
.edit-actions {
  display: flex;
  gap: 16rpx;
  padding: 30rpx 20rpx;
  background: white;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  width: 100%;
  box-sizing: border-box;
}

.cancel-button {
  flex: 1;
  background: #f8f9fa;
  color: #666;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  font-weight: 500;
}

.save-button {
  flex: 1;
  background: #007aff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  font-weight: 500;
}

.cancel-button:active {
  background: #e9ecef;
}

.save-button:active {
  background: #0056cc;
}

/* 加载提示 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f5f5f5;
  width: 100vw;
  max-width: 100vw;
  box-sizing: border-box;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}

/* iOS系统特殊适配 */
@supports (-webkit-touch-callout: none) {
  .character-detail-container {
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .character-header {
    width: 100vw;
    max-width: 100vw;
  }
  
  .character-details {
    width: 100vw;
    max-width: 100vw;
  }
  
  .edit-actions {
    width: 100vw;
    max-width: 100vw;
  }
  
  .loading-container {
    width: 100vw;
    max-width: 100vw;
  }
  
  .prompt-text,
  .voice-model-text,
  .picker-container {
    word-break: break-word;
    -webkit-word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
}

/* Android系统特殊适配 */
@supports not (-webkit-touch-callout: none) {
  .character-detail-container {
    width: 100%;
    max-width: 100%;
  }
  
  .character-header {
    width: 100%;
    max-width: 100%;
  }
  
  .character-details {
    width: 100%;
    max-width: 100%;
  }
  
  .edit-actions {
    width: 100%;
    max-width: 100%;
  }
  
  .loading-container {
    width: 100%;
    max-width: 100%;
  }
  
  .prompt-text,
  .voice-model-text,
  .picker-container {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .character-detail-container {
    width: 100vw;
    max-width: 100vw;
  }
  
  .character-header {
    width: 100vw;
    max-width: 100vw;
  }
  
  .character-details {
    width: 100vw;
    max-width: 100vw;
  }
  
  .edit-actions {
    width: 100vw;
    max-width: 100vw;
  }
  
  .loading-container {
    width: 100vw;
    max-width: 100vw;
  }
} 

/* 头像容器：裁切为圆形 */
.detail-avatar-container {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  overflow: hidden;
}

/* 长图：顶部对齐，配合widthFix */
.detail-avatar-tall {
  height: auto;
  object-position: top;
} 