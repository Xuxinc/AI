.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  box-sizing: border-box;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  color: #666;
  font-size: 28rpx;
}

/* 个人资料内容 */
.profile-content {
  padding: 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
  width: 100%;
  box-sizing: border-box;
}

.avatar-container {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  overflow: hidden;
  background: #e0e0e0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 80rpx;
}

.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 80rpx;
}

.avatar-select-button {
  background: rgba(0, 0, 0, 0.7);
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  min-width: auto;
  height: auto;
}

.avatar-select-button::after {
  border: none;
}

.default-avatar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 48rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  font-size: 20rpx;
  text-align: center;
  padding: 8rpx;
}

/* 信息表单 */
.info-form {
  background: white;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 0;
  border: none;
  background: transparent;
}

.nickname-wrapper {
  flex: 1;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

/* 按钮区域 */
.button-section {
  margin-top: 60rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 编辑按钮 */
.edit-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 操作按钮 */
.action-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-cancel {
  width: 100%;
  height: 88rpx;
  background: #8E8E93;
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background-color 0.2s;
  box-sizing: border-box;
}

.btn-cancel:active {
  background: #6D6D70;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  background: #007AFF;
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background-color 0.2s;
}

.btn-save:active {
  background: #0056CC;
}

.btn-edit {
  width: 100%;
  height: 88rpx;
  background: #FF9500;
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background-color 0.2s;
}

.btn-edit:active {
  background: #E6850E;
}

/* 退出登录 */
.btn-logout {
  width: 100%;
  height: 88rpx;
  background: #FF3B30;
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background-color 0.2s;
}

.btn-logout:active {
  background: #CC2E26;
} 

/* iOS系统特殊适配 */
@supports (-webkit-touch-callout: none) {
  .container {
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .nav-bar {
    width: 100vw;
    max-width: 100vw;
  }
  
  .profile-content {
    width: 100vw;
    max-width: 100vw;
  }
  
  .avatar-section {
    width: 100vw;
    max-width: 100vw;
  }
  
  .info-form {
    width: 100vw;
    max-width: 100vw;
  }
  
  .button-section {
    width: 100vw;
    max-width: 100vw;
  }
  
  .edit-actions,
  .action-actions {
    width: 100vw;
    max-width: 100vw;
  }
}

/* Android系统特殊适配 */
@supports not (-webkit-touch-callout: none) {
  .container {
    width: 100%;
    max-width: 100%;
  }
  
  .nav-bar {
    width: 100%;
    max-width: 100%;
  }
  
  .profile-content {
    width: 100%;
    max-width: 100%;
  }
  
  .avatar-section {
    width: 100%;
    max-width: 100%;
  }
  
  .info-form {
    width: 100%;
    max-width: 100%;
  }
  
  .button-section {
    width: 100%;
    max-width: 100%;
  }
  
  .edit-actions,
  .action-actions {
    width: 100%;
    max-width: 100%;
  }
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .container {
    width: 100vw;
    max-width: 100vw;
  }
  
  .nav-bar {
    width: 100vw;
    max-width: 100vw;
  }
  
  .profile-content {
    width: 100vw;
    max-width: 100vw;
  }
  
  .avatar-section {
    width: 100vw;
    max-width: 100vw;
  }
  
  .info-form {
    width: 100vw;
    max-width: 100vw;
  }
  
  .button-section {
    width: 100vw;
    max-width: 100vw;
  }
  
  .edit-actions,
  .action-actions {
    width: 100vw;
    max-width: 100vw;
  }
} 