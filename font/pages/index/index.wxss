.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 顶部标题区域 */
.header-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.user-avatar {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  overflow: hidden;
  background: #e0e0e0;
  flex-shrink: 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-avatar-hover {
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}

.user-avatar:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.default-avatar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.default-avatar::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transform: rotate(45deg);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
  100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

.avatar-text {
  color: white;
  font-size: 36rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-text {
  color: white;
  font-size: 20rpx;
  font-weight: 500;
}

/* 标题区域 */
.title-section {
  flex: 1;
  margin-left: 30rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 右侧按钮区域 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.action-btn-hover {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 1);
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}

.main-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.sub-title {
  font-size: 24rpx;
  color: #666;
  line-height: 1.2;
}

/* 名人列表滚动区域 */
.characters-scroll {
  flex: 1;
  padding: 0 20rpx 20rpx 20rpx;
  background: linear-gradient(180deg, #f5f5f5 0%, #fafafa 100%);
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 名人网格布局 */
.characters-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 20rpx 0 40rpx 0;
  width: 100%;
  box-sizing: border-box;
}

/* 名人卡片样式 */
.character-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 260rpx;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  animation: fadeInUp 0.6s ease-out;
  animation-fill-mode: both;
  border: 2rpx solid transparent;
  width: 100%;
  box-sizing: border-box;
}

.character-card:nth-child(1) { animation-delay: 0.1s; }
.character-card:nth-child(2) { animation-delay: 0.2s; }
.character-card:nth-child(3) { animation-delay: 0.3s; }
.character-card:nth-child(4) { animation-delay: 0.4s; }
.character-card:nth-child(5) { animation-delay: 0.5s; }
.character-card:nth-child(6) { animation-delay: 0.6s; }
.character-card:nth-child(7) { animation-delay: 0.7s; }
.character-card:nth-child(8) { animation-delay: 0.8s; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.character-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.character-card::after {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  background: linear-gradient(135deg, #007AFF, #5AC8FA, #007AFF);
  border-radius: 22rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: -1;
}

.character-card-hover::after {
  opacity: 0.3;
}

.character-card-hover {
  transform: translateY(-8rpx);
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
  background: #f8f9fa;
  border: 2rpx solid #007AFF;
}

.character-card-hover::before {
  opacity: 1;
}

.character-card:active {
  transform: translateY(-8rpx) scale(1.01);
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  transition: all 0.2s ease;
}

/* 头像容器 */
.character-avatar-container {
  width: 130rpx;
  height: 130rpx;
  border-radius: 65rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 6rpx solid #f8f8f8;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
}

.character-card-hover .character-avatar-container {
  border-color: #007AFF;
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.2);
}

.character-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

/* 长图：顶部对齐显示上部区域 */
.character-avatar-tall {
  height: auto;           /* 允许按宽度自适应高度 */
  object-position: top;   /* 顶部对齐（部分基础库可能忽略，但不影响顶部显示） */
}

/* 名人信息 */
.character-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  transition: all 0.3s ease;
}

.character-card-hover .character-info {
  /* 简化信息效果 */
}

.character-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c3e50;
  line-height: 1.2;
  transition: all 0.3s ease;
  margin-bottom: 4rpx;
}

.character-card-hover .character-name {
  color: #007AFF;
}

.character-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-align: left;
  transition: all 0.3s ease;
}

.character-card-hover .character-desc {
  color: #555;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 30rpx;
  color: #666;
  font-size: 28rpx;
}

.loading-text {
  color: #666;
}

/* 没有更多数据 */
.no-more-state {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more-text {
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 弹窗基础样式 */
.login-modal,
.search-modal,
.add-modal,
.add-celebrity-modal,
.add-custom-modal,
.search-result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  width: 100vw;
  max-width: 100vw;
  box-sizing: border-box;
}

.modal-content {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 40rpx;
  max-width: 600rpx;
  width: calc(100% - 80rpx);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: modalSlideIn 0.3s ease-out;
  box-sizing: border-box;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(50rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.modal-input-section {
  margin-bottom: 40rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}

.modal-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
  margin-top: 20rpx;
}

.modal-options {
  margin-bottom: 40rpx;
}

.option-item {
  padding: 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
  transition: all 0.3s ease;
}

.option-item-hover {
  border-color: #007aff;
  background: #f0f8ff;
  transform: translateY(-2rpx);
}

.option-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.modal-result-content {
  margin-bottom: 40rpx;
}

.result-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 24rpx;
  display: block;
}

.result-character {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid #e9ecef;
}

.result-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-cancel,
.btn-confirm,
.btn-login {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-cancel-hover {
  background: #e0e0e0;
  transform: scale(0.98);
}

.btn-confirm,
.btn-login {
  background: linear-gradient(135deg, #007aff 0%, #0056cc 100%);
  color: white;
}

.btn-confirm-hover,
.btn-login-hover {
  background: linear-gradient(135deg, #0056cc 0%, #004499 100%);
  transform: scale(0.98);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .modal-content {
    margin: 20rpx;
    padding: 32rpx;
    width: calc(100% - 40rpx);
  }
  
  .modal-title {
    font-size: 32rpx;
  }
  
  .modal-input,
  .btn-cancel,
  .btn-confirm,
  .btn-login {
    height: 72rpx;
  }
  
  .header-section {
    margin: 20rpx;
    width: calc(100% - 40rpx);
  }
  
  .characters-scroll {
    padding: 0 20rpx 20rpx 20rpx;
    width: 100%;
  }
  
  .characters-grid {
    width: 100%;
    gap: 20rpx;
  }
} 

.avatar-upload-section {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.btn-upload-avatar {
  background: #f5f5f5;
  color: #007aff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e0e0e0;
  object-fit: cover;
} 

/* iOS系统特殊适配 */
@supports (-webkit-touch-callout: none) {
  .container {
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .header-section {
    width: calc(100vw - 40rpx);
    max-width: calc(100vw - 40rpx);
  }
  
  .characters-scroll {
    width: 100vw;
    max-width: 100vw;
  }
  
  .characters-grid {
    width: 100%;
    max-width: 100%;
  }
  
  .modal-content {
    width: calc(100vw - 80rpx);
    max-width: calc(100vw - 80rpx);
  }
}

/* Android系统特殊适配 */
@supports not (-webkit-touch-callout: none) {
  .container {
    width: 100%;
    max-width: 100%;
  }
  
  .header-section {
    width: calc(100% - 40rpx);
    max-width: calc(100% - 40rpx);
  }
  
  .characters-scroll {
    width: 100%;
    max-width: 100%;
  }
  
  .characters-grid {
    width: 100%;
    max-width: 100%;
  }
  
  .modal-content {
    width: calc(100% - 80rpx);
    max-width: calc(100% - 80rpx);
  }
} 

/* 搜索结果头像：容器裁切 + 长图顶部 */
.result-avatar-container {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.result-avatar-tall {
  height: auto;
  object-position: top;
} 

/* 分类Tabs */
.category-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 8rpx 24rpx 12rpx 24rpx;
  border: 1rpx solid #eaecef;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.category-tab {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #f5f6fa;
  color: #4b4b4b;
  font-size: 26rpx;
  white-space: nowrap;
}
.category-tab.active {
  background: #007AFF;
  color: #fff;
}
.category-text { line-height: 40rpx; } 