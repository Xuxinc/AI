/* 页面容器 */
.voice-call-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  max-width: 100vw;
  box-sizing: border-box;
}

/* 背景头像 */
.background-avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  box-sizing: border-box;
}

.bg-avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}

/* 顶部信息栏 */
.top-bar {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 120rpx 40rpx 30rpx; /* 增加顶部padding，为状态栏留出空间 */
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  width: 100%;
  box-sizing: border-box;
}

/* 左侧区域：返回按钮和名人信息 */
.left-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 自定义返回按钮 */
.custom-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  transition: all 0.3s ease;
}

.custom-back-btn:active {
  transform: scale(0.95);
}

.back-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.character-info {
  display: flex;
  align-items: center;
}

.character-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.character-details {
  display: flex;
  flex-direction: column;
}

.character-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.call-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.top-controls {
  display: flex;
  align-items: center;
}

.toggle-messages-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.toggle-messages-btn.active {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.6);
}

.btn-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.btn-text {
  font-size: 20rpx;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 通话时长显示 */
.call-duration {
  position: relative;
  z-index: 10;
  text-align: center;
  padding: 20rpx 0;
}

.duration-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 2rpx;
}

/* 消息区域 */
.messages-wrapper {
  position: relative;
  z-index: 5;
  height: 45vh; /* 减小高度从60vh到45vh */
  margin: 0 20rpx;
  transition: all 0.3s ease;
  overflow: hidden;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.messages-wrapper.hide {
  height: 0;
  margin: 0;
  opacity: 0;
}

.messages-wrapper.show {
  opacity: 1;
}

.messages-container {
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  width: 100%;
  box-sizing: border-box;
}

.messages-scroll {
  height: 100%;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.messages-list {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

/* 消息项样式 */
.message-item {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 用户消息样式 */
.user-message-content {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  margin-bottom: 32rpx;
  max-width: 100%;
  padding-right: 20rpx; /* 新增：确保头像不会贴边 */
  width: 100%;
  box-sizing: border-box;
}

.user-bubble {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  max-width: 70vw; /* 修改：参考微信设计，设置为视口宽度的70% */
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.3);
  min-width: 80rpx; /* 新增：设置最小宽度 */
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
  box-sizing: border-box; /* 新增：确保padding计算正确 */
  transition: all 0.3s ease; /* 新增：添加过渡效果 */
}

/* 新增：用户消息气泡长按状态样式 */
.user-bubble:active {
  transform: scale(0.98); /* 轻微缩放效果 */
  box-shadow: 0 4rpx 16rpx rgba(79, 172, 254, 0.5); /* 增强阴影效果 */
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  position: relative; /* 新增：确保定位正确 */
  z-index: 1; /* 新增：确保头像在最上层 */
}

/* AI消息样式 */
.ai-message-content {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  max-width: 100%;
  padding-left: 20rpx; /* 新增：确保头像不会贴边 */
  width: 100%;
  box-sizing: border-box;
}

.ai-bubble {
  background: rgba(255, 255, 255, 0.9);
  color: #333;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  max-width: 70vw; /* 修改：参考微信设计，设置为视口宽度的70% */
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  min-width: 80rpx; /* 新增：设置最小宽度 */
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
  box-sizing: border-box; /* 新增：确保padding计算正确 */
  transition: all 0.3s ease; /* 新增：添加过渡效果 */
}

/* 新增：AI消息气泡长按状态样式 */
.ai-bubble:active {
  transform: scale(0.98); /* 轻微缩放效果 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2); /* 增强阴影效果 */
}

.ai-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  position: relative; /* 新增：确保定位正确 */
  z-index: 1; /* 新增：确保头像在最上层 */
}

.message-bubble {
  position: relative;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.message-role {
  font-size: 24rpx;
  font-weight: bold;
  opacity: 0.8;
}

.message-time {
  font-size: 20rpx;
  opacity: 0.6;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
  min-width: 0; /* 新增：允许文本收缩 */
  display: inline-block; /* 新增：确保文本正确换行 */
  max-width: 100%; /* 新增：确保文本不会超出容器 */
  box-sizing: border-box; /* 新增：确保尺寸计算正确 */
  word-break: break-word; /* 新增：确保长单词也能换行 */
}

/* 语音控制按钮 */
.voice-controls {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.voice-play-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: rgba(103, 126, 234, 0.1);
  border: 2rpx solid rgba(103, 126, 234, 0.3);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.voice-play-btn.playing {
  background: rgba(103, 126, 234, 0.2);
  border-color: rgba(103, 126, 234, 0.5);
}

.play-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.play-text {
  font-size: 24rpx;
  color: #667eea;
}

/* 流式消息样式 */
.streaming-message {
  opacity: 0.8;
}

.streaming-bubble {
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
}

.streaming-indicator {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.streaming-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  margin-right: 8rpx;
  animation: streaming-pulse 1.5s infinite;
}

.streaming-dot:nth-child(2) {
  animation-delay: 0.3s;
}

.streaming-dot:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes streaming-pulse {
  0%, 60%, 100% {
    opacity: 0.3;
    transform: scale(1);
  }
  30% {
    opacity: 1;
    transform: scale(1.2);
  }
}

/* 空状态 */
.empty-messages {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

/* 通话状态指示器 */
.call-indicators {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

/* AI思考状态 */
.thinking-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 30rpx;
  backdrop-filter: blur(20rpx);
}

.thinking-dots {
  display: flex;
  gap: 10rpx;
}

.thinking-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
  animation: thinking 1.4s infinite ease-in-out both;
}

.thinking-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.thinking-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes thinking {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.thinking-text {
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

/* 播放状态指示器 */
.playing-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 30rpx;
  backdrop-filter: blur(20rpx);
  min-width: 400rpx; /* 固定最小宽度 */
}

.playing-waves {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
}

.playing-waves .wave {
  width: 6rpx;
  height: 40rpx;
  background: linear-gradient(to top, #4facfe, #00f2fe);
  border-radius: 3rpx;
  animation: wave 1.2s infinite ease-in-out;
}

.playing-waves .wave:nth-child(1) { animation-delay: -1.1s; }
.playing-waves .wave:nth-child(2) { animation-delay: -1.0s; }
.playing-waves .wave:nth-child(3) { animation-delay: -0.9s; }
.playing-waves .wave:nth-child(4) { animation-delay: -0.8s; }

@keyframes wave {
  0%, 40%, 100% {
    transform: scaleY(0.4);
  }
  20% {
    transform: scaleY(1.0);
  }
}

/* 新增：播放打断按钮 */
.playing-interrupt-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  border-radius: 25rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s ease;
  cursor: pointer;
  min-width: 300rpx; /* 固定最小宽度，防止文字变化导致按钮大小变化 */
  text-align: center;
}

.playing-interrupt-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.playing-interrupt-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  display: block;
  line-height: 1.3;
}

/* 底部控制区域 */
.bottom-controls {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 15;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 40rpx 80rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  width: 100vw;
  max-width: 100vw;
  box-sizing: border-box;
}

/* 控制按钮区域 */
.control-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  position: relative;
  box-sizing: border-box;
}

/* 底部显示文字按钮 */
.toggle-messages-btn-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  transition: all 0.3s ease;
  min-width: 120rpx;
  position: absolute;
  left: 40rpx;
}

.toggle-messages-btn-bottom.active {
  opacity: 0.8;
}

.toggle-messages-btn-bottom:active {
  transform: scale(0.95);
  opacity: 0.6;
}

.btn-icon-bottom {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.btn-text-bottom {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  text-align: center;
  line-height: 1.2;
}

/* 暂停录音提示 */
.pausing-recording-indicator {
  background: rgba(255, 193, 7, 0.9);
  color: #333;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
}

/* 录音状态指示器 */
.recording-indicator-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  border-radius: 25rpx;
  background: rgba(220, 53, 69, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(220, 53, 69, 0.3);
}

.recording-indicator-bottom.transparent {
  background: transparent;
  box-shadow: none;
  border: none;
}

.recording-dot {
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

.recording-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.1);
  }
}

/* 结束通话按钮 */
.end-call-btn {
  background: rgba(220, 53, 69, 0.9);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(220, 53, 69, 0.3);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.end-call-btn:active {
  transform: scale(0.95);
  background: rgba(220, 53, 69, 1);
}

.end-call-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 消息容器整体上移留白 */
.messages-wrapper {
  margin-top: -40rpx !important;
} 

/* 新增：针对不同系统的兼容性样式 */
/* iOS系统优化 */
@supports (-webkit-touch-callout: none) {
  .user-bubble,
  .ai-bubble {
    word-break: break-word;
    -webkit-word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
  
  .message-text {
    word-break: break-word;
    -webkit-word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
}

/* Android系统优化 */
@supports not (-webkit-touch-callout: none) {
  .user-bubble,
  .ai-bubble {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  
  .message-text {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
}

/* 新增：针对小屏幕设备的优化 */
@media (max-width: 600rpx) {
  .user-message-content {
    padding-right: 10rpx;
  }
  
  .ai-message-content {
    padding-left: 10rpx;
  }
  
  .user-bubble,
  .ai-bubble {
    max-width: 75vw; /* 小屏幕设备使用更大的最大宽度 */
    min-width: 60rpx;
    padding: 16rpx 20rpx;
  }
  
  .message-text {
    font-size: 26rpx;
  }
}

/* 新增：针对超小屏幕设备的优化 */
@media (max-width: 400rpx) {
  .user-bubble,
  .ai-bubble {
    max-width: 80vw; /* 超小屏幕设备使用更大的最大宽度 */
    min-width: 50rpx;
    padding: 12rpx 16rpx;
  }
  
  .message-text {
    font-size: 24rpx;
  }
}

/* 新增：针对大屏幕设备的优化 */
@media (min-width: 800rpx) {
  .user-bubble,
  .ai-bubble {
    max-width: 65vw; /* 大屏幕设备使用稍小的最大宽度，保持更好的阅读体验 */
  }
} 

/* iOS系统特殊适配 */
@supports (-webkit-touch-callout: none) {
  .voice-call-container {
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .top-bar {
    width: 100vw;
    max-width: 100vw;
  }
  
  .messages-wrapper {
    width: calc(100vw - 40rpx);
    max-width: calc(100vw - 40rpx);
  }
  
  .bottom-controls {
    width: 100vw;
    max-width: 100vw;
  }
  
  .user-bubble,
  .ai-bubble {
    word-break: break-word;
    -webkit-word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
  
  .message-text {
    word-break: break-word;
    -webkit-word-break: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }
}

/* Android系统特殊适配 */
@supports not (-webkit-touch-callout: none) {
  .voice-call-container {
    width: 100%;
    max-width: 100%;
  }
  
  .top-bar {
    width: 100%;
    max-width: 100%;
  }
  
  .messages-wrapper {
    width: calc(100% - 40rpx);
    max-width: calc(100% - 40rpx);
  }
  
  .bottom-controls {
    width: 100%;
    max-width: 100%;
  }
  
  .user-bubble,
  .ai-bubble {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  
  .message-text {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .voice-call-container {
    width: 100vw;
    max-width: 100vw;
  }
  
  .top-bar {
    width: 100vw;
    max-width: 100vw;
  }
  
  .messages-wrapper {
    width: calc(100vw - 40rpx);
    max-width: calc(100vw - 40rpx);
  }
  
  .bottom-controls {
    width: 100vw;
    max-width: 100vw;
  }
  
  .user-bubble,
  .ai-bubble {
    max-width: 75vw;
  }
} 

/* 顶部名人头像容器：圆形裁切 */
.vc-top-avatar-container {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

/* 顶部名人头像：长图顶部对齐（配合widthFix） */
.vc-top-avatar-tall {
  height: auto;
  object-position: top;
}

/* AI消息头像：长图顶部对齐（配合widthFix），保持现有尺寸与圆角 */
.vc-avatar-img-tall {
  height: auto;
  object-position: top;
} 

/* 文字显示区域AI头像容器：与消息头像尺寸一致并圆形裁切 */
.vc-msg-avatar-container {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 复用长图顶部样式（已定义 .vc-avatar-img-tall） */ 

/* 文字显示区域用户头像图片与占位符样式 */
.user-avatar-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: block;
}
.user-avatar-fallback {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
} 